# Dependencies
node_modules/
.pnp/
.pnp.*

# Build output
out/
dist/
release/
*.tsbuildinfo

# DeepSeek Harness runtime (~600MB, rebuilt by scripts/prepare-harness-runtime.mjs)
resources/harness-runtime/

# Electron / bundler cache
.vite/
.electron-vite/
.cache/
.turbo/
# Transpiled copy of electron.vite.config.ts emitted next to it during builds
electron.vite.config.*.mjs

# Packaged artifacts
*.exe
*.msi
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.snap
*.blockmap
*.asar
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle
*.appxupload

# Local signing and publishing credentials (never commit private key material)
*.pfx
*.p12
*.pem
*.key
*.p8
*.snk
*.jks
*.keystore
*.cer
*.crt
*.publishsettings
*.pvk
.secrets/
.certificates/
.publishing/
.partner-center/
partner-center.local.json
store-publishing.local.json

# Logs
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment
.env
.env.*
!.env.example

# Test / coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor local files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local performance diagnostics (machine-specific paths)
.perf/

# Local end-to-end probe: it decrypts the provider credential from this
# machine's data directory and drives a real model call. Useful to re-run
# after a Harness runtime upgrade, but it must never be committed or run by
# anyone whose credential store it does not own.
.e2e-probe/
